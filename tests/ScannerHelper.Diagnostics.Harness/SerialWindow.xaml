<Window x:Class="ScannerHelper.Diagnostics.Harness.SerialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner Helper — 虚拟串口验证 / Virtual COM verification"
        Width="1120" Height="720" MinWidth="880" MinHeight="560"
        Closing="OnWindowClosing">

    <!--
        中文：
          这个窗口**不碰键盘**：不装钩子、不吞任何按键、不合成任何输入。
          它只打开一个串口读字节。所以它在真实工作机上是安全的。

          它要回答的问题只有一个：把扫码枪切到虚拟串口模式之后，我们能不能
          稳定、完整、正确地拿到条码内容——以及业务软件是不是真的一个字符
          都收不到。

          布局自上而下就是操作顺序：选端口和波特率 → 打开 → 扫码 → 看三块结果。
        English:
          This window touches no keyboard: no hook, nothing swallowed, nothing synthesized. It
          opens a COM port and reads bytes, which is why it is safe on a live working machine.

          It answers one question: with the scanner switched to virtual COM mode, can the barcode
          be received completely and correctly — and does the business application really receive
          nothing at all.

          Top to bottom is the order of operations: pick a port and baud rate, open, scan, read
          the three result panels.
    -->

    <DockPanel Margin="10">

        <Border DockPanel.Dock="Top" Background="#E8F5E9" BorderBrush="#66A96B"
                BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock FontWeight="Bold" Foreground="#1B5E20"
                           Text="这个窗口不碰键盘，可以安全地在工作机上运行 / This window touches no keyboard" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#2E4A30"
                           Text="前提：先用扫码枪的配置条码把它切到「USB 虚拟串口 / USB COM Port Emulation」模式。切过去之后它就不再打字了——在记事本里扫应当什么都不出现，这本身就是最重要的一条验证。" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"
                Padding="0,0,0,8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="端口 / Port:" VerticalAlignment="Center" />
                <ComboBox x:Name="PortCombo" Width="130" Height="26" Margin="6,0,0,0" />
                <Button x:Name="RefreshPortsButton" Content="重新列出 / Refresh" Width="140" Height="26"
                        Margin="6,0,0,0" Click="OnRefreshPortsClicked" />

                <TextBlock Text="波特率 / Baud:" VerticalAlignment="Center" Margin="16,0,0,0" />
                <ComboBox x:Name="BaudCombo" Width="110" Height="26" Margin="6,0,0,0" SelectedIndex="0">
                    <ComboBoxItem Content="9600" />
                    <ComboBoxItem Content="115200" />
                    <ComboBoxItem Content="19200" />
                    <ComboBoxItem Content="38400" />
                    <ComboBoxItem Content="57600" />
                    <ComboBoxItem Content="4800" />
                </ComboBox>

                <Button x:Name="OpenButton" Content="打开 / Open" Width="120" Height="28"
                        Margin="16,0,0,0" Click="OnOpenClicked" />
                <Button x:Name="CloseButton" Content="关闭 / Close" Width="120" Height="28"
                        Margin="6,0,0,0" Click="OnCloseClicked" IsEnabled="False" />
                <Button x:Name="ClearButton" Content="清空 / Clear" Width="110" Height="28"
                        Margin="6,0,0,0" Click="OnClearClicked" />

                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0"
                           Text="未打开 / Not open" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0"
                Padding="0,8,0,0" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="期望内容 / Expected:" VerticalAlignment="Center" />
                <TextBox x:Name="ExpectedText" Width="240" Height="26" Margin="6,0,0,0"
                         VerticalContentAlignment="Center"
                         TextChanged="OnExpectedChanged" />
                <TextBlock x:Name="VerdictText" Margin="16,0,0,0" VerticalAlignment="Center"
                           FontWeight="Bold" Text="—" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                           Text="收到的一枪 / Frames — 按终止符切出来的内容" />
                <ListView x:Name="FrameListView" FontSize="12"
                          FontFamily="Consolas, Courier New, monospace">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" Width="42"
                                            DisplayMemberBinding="{Binding Index}" />
                            <GridViewColumn Header="时刻 / Time" Width="86"
                                            DisplayMemberBinding="{Binding Time}" />
                            <GridViewColumn Header="内容 / Content" Width="230"
                                            DisplayMemberBinding="{Binding Text}" />
                            <GridViewColumn Header="长度" Width="50"
                                            DisplayMemberBinding="{Binding Length}" />
                            <GridViewColumn Header="终止符" Width="66"
                                            DisplayMemberBinding="{Binding Terminator}" />
                            <GridViewColumn Header="核对" Width="60"
                                            DisplayMemberBinding="{Binding Match}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                           Text="统计 / Counters" />
                <Border DockPanel.Dock="Top" Padding="8" CornerRadius="3" Background="#F6F6F6">
                    <TextBlock x:Name="CountersText" FontFamily="Consolas, Courier New, monospace"
                               FontSize="12" TextWrapping="Wrap" Text="—" />
                </Border>

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                           Text="原始字节 / Raw bytes — 波特率填错就在这里看得出来" />
                <TextBox x:Name="RawText" FontFamily="Consolas, Courier New, monospace" FontSize="11"
                         IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="#F6F6F6" BorderThickness="1" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
