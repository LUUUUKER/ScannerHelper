<Project Sdk="Microsoft.NET.Sdk">

  <!--
    中文：
      正式的桌面程序（规格 §16）。它是工人真正会看到的那个东西，因此这里的
      每一条设置都直接对应规格里的一条要求。

      ★ 绝不请求提权（规格 §2.1 假设 A2）。业务软件以普通权限运行，本程序必须
        与之同级——权限更高的话，SendInput 发出去的内容会被 UIPI 挡在门外，
        表现是"扫了码什么都没发生"而日志一片正常。

      不引用任何第三方界面库：仓库 IT 按哈希把可执行文件加进白名单（规格 §22.1），
      依赖越少，发布件越容易解释，也越容易复现同一个哈希。
    English:
      The real desktop application (spec §16) — what the operator actually sees, so every
      setting here answers a requirement in the spec.

      It never requests elevation (spec §2.1, assumption A2): the business application runs
      unelevated and this must match, since running higher lets UIPI block our SendInput,
      presenting as "scanning did nothing" with a perfectly normal log.

      No third-party UI libraries: warehouse IT allow-lists the executable by hash (spec §22.1),
      and fewer dependencies make the artifact easier to explain and to reproduce bit for bit.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>

    <!--
      中文：
        托盘图标用的是 WinForms 的 NotifyIcon（规格 §11.9）。

        ★ 这**不引入外部依赖**：WinForms 是 .NET 桌面运行时自带的，与 WPF 同一个
          运行时。仓库 IT 按哈希把可执行文件加进白名单（规格 §22.1），关键是不新增
          要下载的东西，而不是不引用框架里已有的程序集。

          自己写 Shell_NotifyIcon 还要处理图标句柄、以及 explorer.exe 崩溃重启后
          托盘图标消失（TaskbarCreated 消息）等一堆细节，NotifyIcon 都已经处理好了。
      English:
        The tray icon uses WinForms' NotifyIcon (spec §11.9). This adds no external dependency:
        WinForms ships in the same .NET desktop runtime as WPF. Warehouse IT allow-lists the
        executable by hash (spec §22.1), and what matters is adding nothing to download rather than
        avoiding assemblies already in the framework. Writing Shell_NotifyIcon by hand would also
        mean handling icon handles and the tray icon vanishing when explorer.exe restarts (the
        TaskbarCreated message), all of which NotifyIcon already handles.
    -->
    <UseWindowsForms>true</UseWindowsForms>

    <!--
      中文：
        关掉 WinForms 的高 DPI 分析器（WFAC010）。

        ★ 它要求"把 DPI 设置从清单里移到 Application.SetHighDpiMode"，那是给纯
          WinForms 程序的建议。本程序是 WPF，DPI 必须由**清单**声明（规格 §18
          要求支持 100/125/150% 缩放）——WinForms 只是用来画一个托盘图标，
          让它来决定整个程序的 DPI 模式是本末倒置。
      English:
        Disables WinForms' high-DPI analyzer (WFAC010), whose advice — move the DPI setting out of
        the manifest into Application.SetHighDpiMode — is meant for pure WinForms applications.
        This is a WPF program whose DPI awareness must be declared in the manifest (spec §18
        requires 100/125/150% scaling); WinForms is here only to draw a tray icon, and letting it
        decide the whole program's DPI mode would invert the two.
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>

    <AssemblyName>ScannerHelper</AssemblyName>
    <RootNamespace>ScannerHelper.App</RootNamespace>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      中文：界面文字全部来自本地化表，不随系统区域变化而改变格式化行为。
      English: All UI text comes from the localization tables; formatting does not follow the
               system locale.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!--
      中文:
        发布件的身份信息。

        ★ 这不是装饰。规格 §22.1 把杀毒/EDR 列为最高部署风险,而仓库 IT 要把这个
          可执行文件加进白名单时,第一件事就是右键看属性。一个公司名、产品名、
          版本号全空的 exe,在那个场景下和一个来路不明的文件没有区别——而它偏偏
          还在调用 SendInput 往别的程序里打字。

        ★ 版本号会出现在诊断日志的每一行(规格 §15)。现场排查时"他装的还是上一版"
          是第一个要排除的可能,所以这个号必须是真的,不能一直停在 1.0.0.0 的默认值。
      English:
        The artifact's identity. Not decoration: spec §22.1 names antivirus and EDR as the highest
        deployment risk, and the first thing warehouse IT does before allow-listing an executable is
        open its properties. An exe with no company, product or version is indistinguishable from an
        unknown file in that moment — and this one calls SendInput to type into other programs.

        The version also appears on every line of the diagnostic log (spec §15). "They are still
        running the previous build" is the first thing a field investigation rules out, so the
        number has to be real rather than the default 1.0.0.0.
    -->
    <Version>1.0.5</Version>
    <Product>Scanner Helper</Product>
    <AssemblyTitle>Scanner Helper 扫码助手</AssemblyTitle>
    <Company>Scanner Helper</Company>
    <Copyright>Copyright (c) 2026</Copyright>

    <!--
      中文:
        不生成调试符号。pdb 只对开发机有意义,发到工位上属于"非必要的东西"。
      English:
        No debug symbols. A pdb means something only on a development machine; on a workstation it
        is dead weight.
    -->
    <DebugType>none</DebugType>

    <!--
      中文:
        不打包 .NET 自带的几十种语言的附属资源。本程序的中英文来自自己的
        本地化表(规格 §12),框架自带的那些译文一条也用不上。
      English:
        Drops .NET's satellite resources for dozens of languages. This program's Chinese and English
        come from its own localization tables (spec §12) and none of the framework's translations is
        ever used.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      中文：
        去掉 WinForms 的**全局 using**。

        ★ UseWindowsForms 会隐式给每个文件加上 using System.Windows.Forms，于是
          Application、MessageBox、Clipboard 这些名字同时来自 WPF 和 WinForms，
          编译器报歧义——而更坏的情况是它**不报**歧义、悄悄选中了 WinForms 的
          那一个：WinForms 的 MessageBox 在 WPF 程序里不认 Owner，弹出来的框
          可能跑到别的窗口后面去，工人看到的是"程序卡住了"。

          需要 WinForms 的只有托盘那一个文件，让它自己写 using 就够了。
      English:
        Removes WinForms' global using. UseWindowsForms implicitly adds
        using System.Windows.Forms to every file, so Application, MessageBox and Clipboard come
        from both WPF and WinForms and the compiler reports an ambiguity — and worse is when it
        does not, quietly picking WinForms': its MessageBox ignores an Owner in a WPF app and can
        appear behind another window, which the operator reads as "the program froze". Only the
        tray file needs WinForms, and it can write its own using.
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScannerHelper.Core\ScannerHelper.Core.csproj" />
    <ProjectReference Include="..\ScannerHelper.Win32\ScannerHelper.Win32.csproj" />
  </ItemGroup>

</Project>
