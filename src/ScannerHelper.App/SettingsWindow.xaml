<Window x:Class="ScannerHelper.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ScannerHelper.App.Localization"
        Title="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsTitle]}"
        Width="480" Height="600" MinWidth="440" MinHeight="520"
        WindowStartupLocation="CenterOwner">

    <!--
        中文：
          设置窗口（规格 §13）。V1 只放工人或现场负责人真的需要改的东西：
          语言、扫码枪端口、SKU 规则、是否补回车、开机自启。

          ★ 波特率露出来，但不是给工人日常看的。
            决策 D-27 把串口参数做成设置，默认取实测值 9600/8/无/1。换一把枪可能
            要改它——而填错**不会报任何错**，只会收到乱码。

          ★ 「每枪之后按一次回车」默认关闭，并且带一句说明。
            规格 §10 特意点明：关掉时网页收到的回车是 0，而不是"少了一个"。
            这个开关该不该开，取决于那个网页靠不靠回车提交——现场当天才知道，
            所以它必须是一个能当场切的开关，而不是一行代码。

          ★ 「用最近一枪试一下」按钮。
            规格 §8.3 要求规则要能试。工人改完规则最想知道的不是语法对不对，
            而是"它对我手上这个码管不管用"——所以用**他刚扫的那一枪**去试，
            而不是让他再想一个例子出来。
        English:
          The settings window (spec §13). V1 exposes only what an operator or site lead needs:
          language, the scanner's port, the SKU rule, the trailing Enter, start-with-Windows.

          The baud rate is visible but not for daily use: decision D-27 made the serial parameters
          settings with the measured 9600/8/none/1 as defaults. Another scanner may need a different
          value, and a wrong one raises no error at all and merely yields garbage.

          The trailing Enter is off by default and carries an explanation. Spec §10 makes the point
          that off means zero Enters rather than one fewer, and whether it should be on depends on
          whether that page submits on Enter — knowable only on the day, which is why it is a switch
          rather than a line of code.

          The "test with the last scan" button answers spec §8.3. What an operator wants to know
          after editing a rule is not whether the syntax is valid but whether it works on the code
          in their hand, so the test uses the scan they just made rather than asking them to invent
          an example.
    -->

    <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Height="32" MinWidth="110" Click="OnSaveClicked"
                    Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsSave]}" />
            <Button x:Name="CancelButton" Height="32" MinWidth="110" Margin="8,0,0,0"
                    IsCancel="True" Click="OnCancelClicked"
                    Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsCancel]}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock FontWeight="SemiBold" Margin="0,0,0,6"
                           Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsLanguage]}" />
                <ComboBox x:Name="LanguageCombo" Height="28" SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="简体中文" />
                </ComboBox>

                <TextBlock FontWeight="SemiBold" Margin="0,18,0,6"
                           Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsScanner]}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsPort]}" />
                    <ComboBox x:Name="PortCombo" Grid.Column="1" Height="28" Margin="8,0,0,0" />
                    <Button x:Name="RefreshPortsButton" Grid.Column="2" Height="28" Margin="8,0,0,0"
                            Padding="10,0" Click="OnRefreshPortsClicked"
                            Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsRefreshPorts]}" />
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsBaud]}" />
                    <ComboBox x:Name="BaudCombo" Grid.Column="1" Height="28" Margin="8,0,0,0">
                        <ComboBoxItem Content="9600" />
                        <ComboBoxItem Content="115200" />
                        <ComboBoxItem Content="19200" />
                        <ComboBoxItem Content="38400" />
                        <ComboBoxItem Content="57600" />
                        <ComboBoxItem Content="4800" />
                    </ComboBox>
                </Grid>

                <TextBlock FontWeight="SemiBold" Margin="0,18,0,6"
                           Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsSkuRule]}" />
                <StackPanel Orientation="Horizontal">
                    <!--
                        中文：这里**刻意不写 IsChecked="True"**。
                              XAML 里给它初值，Checked 会在 InitializeComponent 期间就触发，
                              而那时 FixedRulePanel 这些字段还没赋值——处理器一访问就是空引用，
                              异常从构造函数抛出去没人接，表现就是"点设置，程序卡死"。
                              初值统一由 Load() 在构造完成之后设。
                        English: IsChecked is deliberately absent here. Setting it in XAML fires
                                 Checked during InitializeComponent, while FixedRulePanel and the
                                 other named fields are still null — the handler dereferences null,
                                 the exception escapes the constructor uncaught, and the symptom is
                                 "click Settings and the program freezes". Load() sets the initial
                                 state after construction instead.
                    -->
                    <RadioButton x:Name="FixedRuleRadio" GroupName="RuleType"
                                 Checked="OnRuleTypeChanged"
                                 Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsRuleFixed]}" />
                    <RadioButton x:Name="RegexRuleRadio" GroupName="RuleType" Margin="18,0,0,0"
                                 Checked="OnRuleTypeChanged"
                                 Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsRuleRegex]}" />
                </StackPanel>

                <Grid x:Name="FixedRulePanel" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsStartPosition]}" />
                    <TextBox x:Name="StartPositionBox" Grid.Column="1" Height="26" Margin="8,0,0,0"
                             VerticalContentAlignment="Center" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"
                               Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsLength]}" />
                    <TextBox x:Name="LengthBox" Grid.Column="3" Height="26" Margin="8,0,0,0"
                             VerticalContentAlignment="Center" />
                </Grid>

                <Grid x:Name="RegexRulePanel" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                               Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsRegexPattern]}" />
                    <TextBox x:Name="RegexBox" Grid.Row="0" Grid.Column="1" Height="26" Margin="8,0,0,0"
                             FontFamily="Consolas, Courier New, monospace"
                             VerticalContentAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,0,0"
                               Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsCaptureGroup]}" />
                    <TextBox x:Name="CaptureGroupBox" Grid.Row="1" Grid.Column="1" Height="26"
                             Margin="8,8,0,0" HorizontalAlignment="Left" Width="70"
                             VerticalContentAlignment="Center" />
                </Grid>

                <Button x:Name="TestRuleButton" Height="28" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Padding="12,0" Click="OnTestRuleClicked"
                        Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsTest]}" />
                <TextBlock x:Name="TestResultText" Margin="0,6,0,0" TextWrapping="Wrap"
                           FontFamily="Consolas, Courier New, monospace" FontSize="12" />

                <!--
                    中文：
                      SKU 校验（规格 §9）。三项各自独立，打开的都必须通过。

                      ★ 留空 = 不启用，而不是"填 0"。长度用可空整数表达"没设这一项"，
                        界面上就该是空着的输入框。逼工人填一个 0 去表示"不检查"，
                        等于让他记住一条只有程序才懂的约定。

                      ★ 「忽略大小写」单独一项，且默认开启（规格 §9.2）。
                        它只管字符集这一项，不影响长度、不影响校验正则。仅仅因为
                        有个小写字母就把一个本来正确的条码拒掉，比放过它更糟——
                        真要求全大写的现场，应当写在正则里。
                    English:
                      SKU validation (spec §9). The three checks are independent and every enabled
                      one must pass.

                      Empty means off rather than "type 0": lengths are nullable, so "not set" is an
                      empty box. Forcing a 0 to mean "do not check" would make the operator memorize
                      a convention only the program understands.

                      Ignore case is separate and on by default (spec §9.2). It governs the
                      character set alone and affects neither length nor the validation pattern.
                      Rejecting an otherwise valid barcode purely for a lowercase letter is a worse
                      failure than accepting one; a site that genuinely requires uppercase says so
                      in the pattern.
                -->
                <TextBlock FontWeight="SemiBold" Margin="0,18,0,2"
                           Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsValidation]}" />
                <TextBlock Margin="0,0,0,6" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsValidationHint]}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsMinLength]}" />
                    <TextBox x:Name="MinLengthBox" Grid.Column="1" Height="26" Margin="8,0,0,0"
                             VerticalContentAlignment="Center" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"
                               Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsMaxLength]}" />
                    <TextBox x:Name="MaxLengthBox" Grid.Column="3" Height="26" Margin="8,0,0,0"
                             VerticalContentAlignment="Center" />
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsCharacterSet]}" />
                    <ComboBox x:Name="CharacterSetCombo" Grid.Column="1" Height="26" Margin="8,0,0,0">
                        <ComboBoxItem Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsCharsAny]}" />
                        <ComboBoxItem Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsCharsNumbers]}" />
                        <ComboBoxItem Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsCharsLetters]}" />
                        <ComboBoxItem Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsCharsLettersNumbers]}" />
                        <ComboBoxItem Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsCharsLettersNumbersDashUnderscore]}" />
                    </ComboBox>
                </Grid>

                <CheckBox x:Name="IgnoreCaseCheck" Margin="0,10,0,0"
                          Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsIgnoreCase]}" />
                <TextBlock Margin="22,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsIgnoreCaseHint]}" />

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsValidationRegex]}" />
                    <TextBox x:Name="ValidationRegexBox" Grid.Column="1" Height="26" Margin="8,0,0,0"
                             FontFamily="Consolas, Courier New, monospace"
                             VerticalContentAlignment="Center" />
                </Grid>
                <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsValidationRegexHint]}" />

                <TextBlock FontWeight="SemiBold" Margin="0,18,0,6"
                           Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsOutput]}" />
                <CheckBox x:Name="AppendEnterCheck"
                          Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsAppendEnter]}" />
                <TextBlock Margin="22,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsAppendEnterHint]}" />

                <TextBlock FontWeight="SemiBold" Margin="0,18,0,6"
                           Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsSound]}" />
                <CheckBox x:Name="ModeSoundCheck"
                          Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsModeSound]}" />
                <TextBlock Margin="22,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsModeSoundHint]}" />
                <CheckBox x:Name="ErrorSoundCheck" Margin="0,10,0,0"
                          Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsErrorSound]}" />
                <TextBlock Margin="22,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsErrorSoundHint]}" />

                <CheckBox x:Name="StartWithWindowsCheck" Margin="0,18,0,0"
                          Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SettingsStartWithWindows]}" />

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
