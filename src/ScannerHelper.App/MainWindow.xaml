<Window x:Class="ScannerHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ScannerHelper.App.Localization"
        Title="{Binding Source={x:Static loc:Localizer.Strings}, Path=[AppTitle]}"
        Width="420" Height="560" MinWidth="360" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        StateChanged="OnStateChanged"
        Closing="OnClosing">

    <!--
        中文：
          Full 窗口（规格 §11.1）。自上而下：状态大面板 → 连接与最近一枪 → 操作条。

          ★ 模式名是最大的元素，这不是审美取向。
            工人隔着一两米、在搬货的间隙抬眼一看就要认出现在是 SN 还是 SKU；
            认错了，接下来几十枪都会以错误的形式进仓库系统，而他低着头毫不知情。

          ★ 暂停时整块面板被"已暂停"顶掉，而不是在角落加个小标记。
            规格 §11.1 明写：暂停时绝不能还显示着一个自信的 SN MODE。暂停会绕过
            解析与校验（决策 D-26），那是一个非常态；小标记看不见，而看不见就会有人
            在暂停下干一整天。

          ★ 出错时整块面板变红并带斜条纹。条纹是给色觉障碍准备的——红绿正是最难
            分辨的一对，而 SN 的绿和错误的红会先后出现在同一个位置上（规格 §11.2）。
        English:
          The Full window (spec §11.1): the state panel, then connection and last scan, then the
          action bar.

          The mode name is the largest element, and not for aesthetic reasons: the operator glances
          up from a metre or two away, between lifting boxes, to see whether this is SN or SKU.
          Getting it wrong sends the next few dozen scans into the warehouse system in the wrong
          shape while they never look up again.

          Pausing overrides the whole panel rather than adding a corner badge. Spec §11.1 is
          explicit that a paused pipeline must never show a confident SN MODE. Pausing bypasses
          parsing and validation (decision D-26) and is exceptional; a badge goes unseen, and unseen
          lets somebody work a whole shift in it.

          An error turns the panel red with a diagonal hazard stripe. The stripe is for color-vision
          deficiency: red against green is the hardest pair to tell apart, and SN's green and the
          error's red appear one after another in the same place (spec §11.2).
    -->

    <DockPanel>

        <!-- 操作条 / Action bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ChromeBrush}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    中文：暂停/恢复按钮**必须鼠标可达**（规格 §5.7）。它是安全阀，
                          不能只有键盘入口——出问题的时候键盘可能正是不能用的那个东西。
                    English: Pause/Resume must be mouse-reachable (spec §5.7). It is the safety
                             valve, and a keyboard-only entrance fails when the keyboard is the
                             thing that is wrong.
                -->
                <Button x:Name="PauseButton" Grid.Column="0" HorizontalAlignment="Left"
                        Style="{StaticResource ActionButton}" Click="OnPauseClicked" />

                <!--
                    中文：
                      置顶开关（规格 §11.4）。

                      ★ 只管 Full 窗口。Compact 是**强制**置顶的——它小得不挡事，
                        而它存在的全部意义就是"抬眼就能看到现在是什么模式"，
                        被业务软件盖住的置顶窗口等于没有。所以那边没有这个开关。

                      ★ 从 Compact 回到 Full 时，要恢复工人**在 Full 上**的偏好，
                        而不是把 Compact 的强制置顶带回来（规格 §11.4 明写这一条）。
                    English:
                      The always-on-top switch (spec §11.4). It governs the Full window only:
                      Compact forces topmost, because it is small enough not to be in the way and
                      its entire purpose is that a glance shows the mode — a topmost window covered
                      by the business application would be no window at all. Hence no switch there.

                      Returning from Compact to Full restores the operator's preference for Full
                      rather than carrying Compact's forced topmost back with it, which spec §11.4
                      states explicitly.
                -->
                <ToggleButton x:Name="PinButton" Grid.Column="1" HorizontalAlignment="Right"
                              Height="38" MinWidth="120" FontSize="14" Padding="14,0"
                              Margin="0,0,8,0"
                              Checked="OnPinChanged" Unchecked="OnPinChanged" />

                <Button x:Name="SettingsButton" Grid.Column="2" HorizontalAlignment="Right"
                        Style="{StaticResource ActionButton}" Click="OnSettingsClicked"
                        Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[Settings]}" />
            </Grid>
        </Border>

        <!-- 连接状态与最近一枪 / Connection and last scan -->
        <Border DockPanel.Dock="Bottom" Padding="14,10" Background="White">
            <StackPanel>
                <TextBlock x:Name="ConnectionText" FontSize="13"
                           Foreground="{StaticResource ChromeTextBrush}" TextWrapping="Wrap" />

                <TextBlock x:Name="LinkWarningText" FontSize="12" Margin="0,6,0,0"
                           Foreground="#8A4B08" TextWrapping="Wrap" Visibility="Collapsed" />

                <!--
                    中文：
                      候选端口的一键确认。

                      ★ 只在"匹配上了但置信度不够自动连"时出现。程序看到的是 VID/PID
                        一样，而它看不到桌上有几把枪——那个判断本来就该工人来做，
                        他知道自己刚把枪插到了哪个口。
                        自动连上一个不对的设备，界面会显示"已连接"而扫码永远没反应，
                        那是规格 §19.1 最忌讳的"看起来在工作"。
                    English:
                      One-click confirmation of a suggested port, shown only when something matched
                      but not confidently enough to connect on its own. The program sees matching
                      vendor and product IDs and cannot see how many scanners are on the desk; that
                      judgment was always the operator's, who knows which socket they just used.
                      Connecting to the wrong device would leave the UI saying "connected" while
                      scanning never produces anything — spec §19.1's "looks like it is working".
                -->
                <Border x:Name="SuggestionPanel" Visibility="Collapsed" Margin="0,8,0,0"
                        Background="#FFF4E5" BorderBrush="#E8A33D" BorderThickness="1"
                        CornerRadius="3" Padding="8">
                    <StackPanel>
                        <TextBlock x:Name="SuggestionText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="#5A3A10" />
                        <Button x:Name="ConnectSuggestedButton" Height="28" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Padding="14,0"
                                Click="OnConnectSuggestedClicked"
                                Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[ReconnectConnect]}" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,10,0,0" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding Source={x:Static loc:Localizer.Strings}, Path=[LastScan]}" />
                <TextBlock x:Name="LastScanText" FontSize="15" FontFamily="Consolas, Courier New, monospace"
                           Foreground="{StaticResource ChromeTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 状态大面板 / The state panel -->
        <Border x:Name="StatePanel" Background="{StaticResource SnBrush}">
            <Grid>
                <!--
                    中文：错误状态的斜条纹。平时隐藏，出错时露出来——它是规格 §11.2
                          要求的"不依赖颜色的标志"，色觉障碍或屏幕发白时它仍然管用。
                    English: The error state's diagonal hazard stripe, hidden until needed. It is
                             spec §11.2's non-color signature, still working under color-vision
                             deficiency or on a washed-out panel.
                -->
                <Border x:Name="HazardStripe" Height="10" VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <Border.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#FFFFFF">
                                    <GeometryDrawing.Geometry>
                                        <PathGeometry Figures="M0,20 L10,0 L20,0 L10,20 Z" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Border.Background>
                </Border>

                <!--
                    中文：未连接时的红色顶栏（规格 §11.2）。与暂停共用同一个灰底，
                          靠这条红栏区分——两者都是"没有在处理"，但原因完全不同。
                    English: The red top bar for the disconnected state (spec §11.2). It shares the
                             slate background with PAUSED and is told apart by this bar: both mean
                             nothing is being processed, for entirely different reasons.
                -->
                <Border x:Name="DisconnectedBar" Height="8" VerticalAlignment="Top"
                        Background="#B3261E" Visibility="Collapsed" />

                <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock x:Name="StateHeadingText" Style="{StaticResource StateHeading}" />
                    <TextBlock x:Name="StateTitleText" Style="{StaticResource StateTitle}"
                               Margin="0,10,0,0" />
                    <TextBlock x:Name="StateSubtitleText" Style="{StaticResource StateSubtitle}" />

                    <TextBlock x:Name="ModeOnResumeText" Style="{StaticResource StateSubtitle}"
                               Margin="16,16,16,0" Visibility="Collapsed" />

                    <TextBlock x:Name="ErrorCodeText" Style="{StaticResource StateSubtitle}"
                               Margin="16,14,16,0" FontSize="16"
                               FontFamily="Consolas, Courier New, monospace"
                               Visibility="Collapsed" />

                    <!--
                        中文：出错时的两个出口。它们**也必须鼠标可达**——F10 与 Esc
                              是快捷方式，不是唯一入口（规格 §11.1 的按钮化原则）。
                        English: The two exits from an error. These must also be mouse-reachable:
                                 F10 and Escape are shortcuts, not the only way in.
                    -->
                    <StackPanel x:Name="ErrorActions" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,18,0,0"
                                Visibility="Collapsed">
                        <Button x:Name="ForceSendButton" Style="{StaticResource ActionButton}"
                                Click="OnForceSendClicked"
                                Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[ForceSend]}" />
                        <Button x:Name="DiscardButton" Style="{StaticResource ActionButton}"
                                Margin="10,0,0,0" Click="OnDiscardClicked"
                                Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[DiscardScan]}" />
                    </StackPanel>

                    <TextBlock x:Name="SwitchHintText" Style="{StaticResource StateSubtitle}"
                               Margin="16,22,16,0" FontSize="12" Opacity="0.75" />

                    <Button x:Name="SwitchModeButton" Style="{StaticResource ActionButton}"
                            HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnSwitchModeClicked"
                            Content="{Binding Source={x:Static loc:Localizer.Strings}, Path=[SwitchMode]}" />
                </StackPanel>
            </Grid>
        </Border>

    </DockPanel>
</Window>
